{
  "selftest": {"hash": "#selftest", "text": "No problems found.", "timeout_ms": 30000},
  "viewports": [
    {"name": "desktop", "width": 1280, "height": 720},
    {"name": "phone", "width": 720, "height": 1280, "touch": true},
    {"name": "small", "width": 390, "height": 844, "touch": true},
    {"name": "calm", "width": 720, "height": 1280, "touch": true, "reduced_motion": true}
  ],
  "steps": [
    {"wait": 600},
    {"shot": "title"},
    {"eval": "lang + ' ' + $('langBtn').classList.contains('hidden')", "save": "lang_default", "expect": "en true"},
    {"eval": "addWords({en: {}, fr: {}}), setLang(lang), $('langBtn').textContent", "only": "phone", "save": "lang_button", "expect": "Français"},
    {"click": "#langBtn", "only": "phone", "after": 200},
    {"eval": "[lang, $('playBtn').textContent, $('soundBtn').textContent, document.documentElement.lang].join(' | ')", "only": "phone", "save": "lang_french", "expect": "fr | Jouer | Son : activé | fr"},
    {"shot": "title-fr", "only": "phone"},
    {"click": "#langBtn", "only": "phone", "after": 200},
    {"eval": "[lang, $('playBtn').textContent, store.get('lang', null)].join(' | ')", "only": "phone", "save": "lang_back", "expect": "en | Play | en"},
    {"eval": "document.title", "expect": "Pop"},
    {"eval": "fx.calm", "only": "calm", "save": "calm_mode", "expect": true},
    {"eval": "fx.calm", "only": "phone", "expect": false},
    {"click": "#playBtn", "after": 300},
    {"eval": "scene", "expect": "play"},
    {"eval": "music.song !== null", "save": "music_started", "expect": true},
    {"eval": "fx.banners.length === 1 && fx.banners[0].title === 'Go!'", "save": "banner_on_start", "expect": true},
    {"eval": "paint.shade('#808080', -1) + ' ' + paint.shade('#808080', 1) + ' ' + paint.mix('#000000', '#ffffff', 0.5)", "only": "desktop", "save": "colour_maths", "expect": "#000000 #ffffff #808080"},
    {"wait": 250, "only": "phone"},
    {"shot": "banner", "only": "phone"},
    {"tap": [0.5, 0.5], "after": 100},
    {"eval": "!!Game.lastTap && Math.round(Game.lastTap.x) === 360 && Math.round(Game.lastTap.y) === 640", "save": "centre_tap_maps_to_stage_centre", "expect": true},
    {"eval": "fx.parts.length > 0", "save": "tap_makes_sparks", "expect": true},
    {"eval": "sound.ac !== null", "save": "sound_unlocked_by_gesture", "expect": true},
    {"eval": "Game.stick = true", "only": "phone"},
    {"drag": [0.5, 0.75, 0.75, 0.75], "only": "phone", "probe": "stick.active && stick.x > 0.99 && Math.abs(stick.y) < 0.05", "save": "stick_full_right", "expect": true},
    {"eval": "stick.active", "only": "phone", "save": "stick_released", "expect": false},
    {"eval": "choose('Level up!', [{label: 'Faster', detail: '+20% speed'}, {label: 'Bigger', detail: '+20% size'}, {label: 'Heal'}], i => { window.picked = i; })", "only": "phone", "expect": true},
    {"wait": 200, "only": "phone"},
    {"shot": "choose", "only": "phone"},
    {"eval": "scene", "only": "phone", "expect": "choose"},
    {"click": "#chooseList button >> nth=1", "only": "phone", "after": 200},
    {"eval": "window.picked", "only": "phone", "save": "picked_card", "expect": 1},
    {"eval": "scene", "only": "phone", "expect": "play"},
    {"eval": "Game.bubbles.push({x: 200, y: 380, r: 80, v: 0, s: 1, star: true}) > 0", "only": "phone", "save": "star_pinned", "expect": true},
    {"eval": "Game.stick = true", "only": "desktop"},
    {"drag": [0.5, 0.75, 0.62, 0.75], "only": "desktop", "probe": "stick.active && stick.x > 0.99", "save": "stick_full_right_letterboxed", "expect": true},
    {"eval": "choose('Keys', [{label: 'One'}, {label: 'Two'}], i => { window.keyPicked = i; })", "only": "desktop", "expect": true},
    {"key": "2", "only": "desktop", "after": 100},
    {"eval": "window.keyPicked", "only": "desktop", "save": "key_picked", "expect": 1},
    {"eval": "scene", "only": "desktop", "expect": "play"},
    {"wait": 2500},
    {"eval": "fx.banners.length", "save": "banner_gone", "expect": 0},
    {"eval": "sound.ac.state", "save": "audio_state"},
    {"eval": "music.step", "save": "music_steps_after_2_5s"},
    {"shot": "play"},
    {"click": "#pauseBtn", "after": 200},
    {"eval": "scene", "expect": "paused"},
    {"eval": "music.next", "save": "music_parked_while_paused", "expect": 0},
    {"shot": "paused"},
    {"click": "#resumeBtn", "after": 200},
    {"eval": "scene", "expect": "play"},
    {"wait": 16000},
    {"eval": "scene", "save": "scene_after_idle", "expect": "over"},
    {"shot": "over"},
    {"click": "#menuBtn", "after": 300},
    {"eval": "scene", "expect": "title"}
  ],
  "video": {
    "viewport": "phone",
    "min_seconds": 20,
    "max_seconds": 60,
    "steps": [
      {"wait": 1500},
      {"click": "#playBtn", "after": 1200},
      {"tap": [0.3, 0.7], "after": 1200},
      {"tap": [0.6, 0.6], "after": 1200},
      {"tap": [0.45, 0.5], "after": 1200},
      {"tap": [0.7, 0.45], "after": 1200},
      {"tap": [0.3, 0.4], "after": 1200},
      {"tap": [0.55, 0.55], "after": 1200},
      {"tap": [0.4, 0.35], "after": 1200},
      {"tap": [0.65, 0.5], "after": 1200},
      {"eval": "Game.score", "save": "video_score"},
      {"wait": 18000},
      {"eval": "scene", "save": "video_end_scene", "expect": "over"},
      {"wait": 2000}
    ]
  }
}
